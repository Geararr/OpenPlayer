import { Button, VerticalBox, HorizontalBox, TabWidget, ScrollView, ListView, Palette, Slider, LineEdit, GridBox } from "std-widgets.slint";

export global Theme {
    in-out property <color> background-main: rgb(32, 32, 43);
    in-out property <color> background-panel: rgba(17, 17, 27, 0.8);
    in-out property <color> border-sublte: rgb(154, 184, 255);
    in-out property <color> text-primary: rgb(215, 215, 247);
    in-out property <color> button-normal: rgb(36, 41, 44);
    out property <color> button-selected: button-normal.darker(0.3);
    out property <color> button-hover: button-normal.brighter(0.3);
}
export global Default-Theme {
    in-out property <color> background-main: rgb(32, 32, 43);
    in-out property <color> background-panel: rgba(17, 17, 27, 0.8);
    in-out property <color> border-sublte: rgb(154, 184, 255);
    in-out property <color> text-primary: rgb(215, 215, 247);
    in-out property <color> button-normal: rgb(36, 41, 44);
    out property <color> button-selected: button-normal.darker(0.3);
    out property <color> button-hover: button-normal.brighter(0.3);
}

export global ColorUtils {
    pure callback to-hex(color) -> string;
    pure callback from-hex(string) -> color;
}

export struct PendingSong {
    image: image,
    title: string,
}

export component CustomButton inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.text-primary;
    in property <length> font-size: 16px;
    callback clicked <=> touch.clicked;

    in property <bool> selected: false;

    height: 32px;
    border-radius: 4px;
    background: selected ? Theme.button-selected : (touch.has-hover ? Theme.button-hover : Theme.button-normal);

    touch := TouchArea {}

    Text {
        width: parent.width - 16px;
        text: root.text;
        font-size: root.font-size;
        color: root.text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component PendingSongButton inherits Rectangle {
    in property <image> art;
    in property <string> text;
    in property <color> text-color: Theme.text-primary;
    in property <length> font-size: 14px;
    in property <bool> selected: false;
    callback clicked <=> touch.clicked;

    min-height: 40px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.button-hover : (root.selected ? Theme.button-selected : Theme.button-normal);

    touch := TouchArea {}

    HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;

        Image {
            width: 24px;
            height: 24px;
            source: root.art;
            image-fit: contain;
            vertical-alignment: center;
        }

        Text {
            min-width: 0px;
            text: root.text;
            font-size: root.font-size;
            color: root.text-color;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component ScrollableSelectionBox inherits Rectangle {
    in property <string> button-text: "▼";
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <length> max-popup-height: 200px;
    in property <length> font-size: 16px;

    in property <bool> selected;

    callback select(int, string);

    height: 36px;
    border-width: 1px;
    border-radius: 4px;
    background: selected ? Theme.button-selected : (touch.has-hover ? Theme.button-hover : Theme.button-normal);

    touch := TouchArea {
        clicked => { popup.show(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;

        Text {
            min-width: 0px;
            horizontal-stretch: 1;
            horizontal-alignment: center;
            text: root.button-text;
            color: Theme.text-primary;
            vertical-alignment: center;
            font-size: root.font-size;
            overflow: elide;
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        height: min(root.max-popup-height, root.model.length * 32px + 4px);

        Rectangle {
            background: Theme.background-panel;
            border-width: 1px;
            border-radius: 4px;

            ListView {
                width: parent.width;
                height: parent.height;

                for item[idx] in root.model : CustomButton {
                    width: parent.width;
                    text: item;
                    font-size: 14px;
                    selected: idx == root.current-index;
                    text-color: Theme.text-primary;

                    clicked => {
                        root.current-index = idx;
                        root.select(idx, item);
                        popup.close();
                    }
                }
            }
        }
    }
}

// Interfaces
export component LeftInterface inherits Rectangle {
    in property <[string]> playlists;
    callback playlist_set(int);

    in property <int> current-tab;
    callback set-tab(int);

    in property <bool> is-playing: false;

    background: Theme.background-panel;
    width: 180px;
    vertical-stretch: 1;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-sublte;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            alignment: start;
            padding: 8px;
            spacing: 8px;

            Text {
                text: is-playing
                    ? ("\u{000F040A} Playing" + (mod(floor(animation-tick() / 400ms), 4) == 0 ? "" : (mod(floor(animation-tick() / 400ms), 4) == 1 ? "." : (mod(floor(animation-tick() / 400ms), 4) == 2 ? ".." : "..."))))
                    : "\u{000F03E4} Paused...";

                color: is-playing
                    ? Theme.text-primary.brighter(0.5 + 0.5 * sin(animation-tick() / 600ms * 1rad))
                    : Theme.text-primary;

                horizontal-alignment: center;
            }

            CustomButton { // config = 0
                text: "\u{e615} Config";
                selected: root.current-tab == 0;

                clicked => {
                    root.set-tab(0);
                }
            }
            CustomButton { // discover = 1
                text: "\u{f002} Discover";
                selected: root.current-tab == 1;

                clicked => {
                    root.set-tab(1);
                }
            }
            ScrollableSelectionBox { // playlists/song = 2
                button-text: "▼ Playlists";
                model: playlists;
                selected: current-tab == 2;

                select(idx, text) => {
                    root.set-tab(2);
                    root.playlist_set(idx);
                }
            }
        }
    }
}

export component SoundsInterface inherits Rectangle {
    in property <image> current-image;
    in property <string> current-sound;
    in property <string> toggle-button;
    in property <[PendingSong]> pendingSongs: [];

    in property <string> current-time-text: "0:00";
    in property <string> total-time-text: "0:00";
    in-out property <float> volume: 1.0;

    callback previous-song();
    callback next-song();
    callback toggle-music();
    callback song-set(int);

    // volume
    callback volume-changed(float);

    min-width: 0px;
    max-width: 100000px;
    background: Theme.background-panel;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-sublte;

    // Music art and queue
    VerticalBox {
        spacing: 8px;

        HorizontalLayout {
        alignment: center;
            Image {
                width: 200px; height: 200px;
                source: current-image;
                image-fit: contain;
            }
        }

        Text {
            min-width: 0px;
            text: current-sound;
            font-size: 24px;
            color: Theme.text-primary;
            horizontal-alignment: center;
            overflow: elide;
        }

        // Song progress bar
        HorizontalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: root.current-time-text;
                color: Theme.text-primary;
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: root.total-time-text;
                color: Theme.text-primary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        // Volume Bar
        HorizontalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: root.volume == 0 ? "\u{000F0581}" : (root.volume < 0.5 ? "\u{000F0580}" : "\u{000F057E}");
                color: Theme.text-primary;
                font-size: 16px;
                vertical-alignment: center;
            }

            Slider {
                width: 140px;
                minimum: 0.0;
                maximum: 1.0;
                value <=> root.volume;
                changed(val) => {
                    root.volume-changed(val);
                }
            }
        }

        HorizontalBox {
            alignment: center;
            cross-axis-alignment: center;
            spacing: 10px;

            Button {
                text: "\u{000F04AE}";
                clicked() => { previous-song(); }
            }

            Button {
                text: toggle-button;
                clicked() => { toggle-music(); }
            }

            Button {
                text: "\u{000F04AD}";
                clicked() => { next-song(); }
            }
        }

        Rectangle {
            background: Theme.background-panel;
            vertical-stretch: 1;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-sublte;

            scroll := ScrollView {
                width: 100%;
                height: parent.height - 8px;

                VerticalLayout {
                    width: scroll.visible-width;
                    alignment: start;
                    padding: 8px;
                    spacing: 5px;

                    for pending_song[index] in pendingSongs : PendingSongButton {
                        art: pending-song.image;
                        text: pending-song.title;

                        selected: current-sound == pending-song.title;

                        clicked => {
                            root.song-set(index);
                        }
                    }
                }
            }
        }
    }
}

export component ColorWheel inherits Rectangle {
    in-out property <angle> hue: 0deg;
    in-out property <float> saturation: 1.0;
    in-out property <float> alpha: 1.0;
    in-out property <float> value: 1.0;
    in property <color> external-color;
    out property <color> selected-color: Colors.hsv(root.hue / 1deg, root.saturation, root.value).with-alpha(alpha);

    callback set-color(color);

    public function sync-from-external() {
        let hsv = root.external-color.to-hsv();
        root.hue = hsv.hue * 1deg;
        root.saturation = hsv.saturation;
        root.value = hsv.value;
        root.alpha = hsv.alpha;
    }

    init => {
        root.sync-from-external();
    }

    changed external-color => {
        root.sync-from-external();
    }

    width: 100px;
    height: 100px;

    wheel := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: @conic-gradient(
            #80ff00 0deg,
            #00ff00 30deg,
            #00ffff 90deg,
            #0000ff 150deg,
            #ff00ff 210deg,
            #ff0000 270deg,
            #ffff00 330deg,
            #80ff00 360deg
        );

        Rectangle {
            border-radius: parent.border-radius;
            background: @radial-gradient(circle, #ffffff 0%, #ffffff00 100%);
        }

        Rectangle {
            border-radius: parent.border-radius;
            background: #000000;
            opacity: 1.0 - root.value;
        }
    }

    Rectangle {
        property <length> radius: (root.width / 2) * root.saturation;
        x: (root.width / 2) + self.radius * sin(root.hue) - (self.width / 2);
        y: (root.height / 2) - self.radius * cos(root.hue) - (self.height / 2);
        width: 12px;
        height: 12px;
        border-radius: 7px;
        border-width: 2px;
        border-color: #ffffff;
        background: root.selected-color;
    }

    touch := TouchArea {
        function update-color() {
            let dx = (self.mouse-x - root.width / 2) / 1px;
            let dy = (self.mouse-y - root.height / 2) / 1px;
            let r = (root.width / 2) / 1px;

            let raw-angle = atan2(dx, -dy);
            root.hue = raw-angle < 0deg ? raw-angle + 360deg : raw-angle;

            root.saturation = clamp(sqrt(dx * dx + dy * dy) / r, 0.0, 1.0);
        }

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.update-color();
            }
            else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                self.update-color();
                root.set-color(root.selected-color);
            }
        }
        moved => {
            if (self.pressed) {
                self.update-color();
            }
        }
    }
}

export component ConfigColorBlock inherits Rectangle {
    in property <string> property-display-name: "Property-Display-Name";
    in property <string> property-name: "Property";
    in property <bool> color-wheel: true;
    in-out property <string> property-value: "Value";
    callback value-edited(string);

    height: color-wheel ? 250px : 75px;
    width: 175px;

    border-width: 1px;
    border-radius: 4px;
    background: Theme.button-normal;

    VerticalBox {
        cross-axis-alignment: center;
        Text {
            text: property-display-name;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Theme.text-primary;
        }

        LineEdit {
            text: root.property-value;
            horizontal-alignment: center;
            accepted(new-text) => {
                root.property-value = new-text;
                root.value-edited(new-text);
                self.clear-focus();
            }
        }
        if color-wheel : VerticalBox {
            spacing: 6px;
            wheel := ColorWheel {
                external-color: ColorUtils.from-hex(root.property-value);
                value <=> brightness-slider.value;
                alpha <=> alpha-slider.value;

                set-color(color) => {
                    root.property-value = ColorUtils.to-hex(color);
                    root.value-edited(root.property-value);
                }
            }

            brightness-slider := Slider {
                minimum: 0.0;
                maximum: 1.0;
                value: 1.0;

                changed(value) => {
                    if (self.has-focus) {
                        root.property-value = ColorUtils.to-hex(wheel.selected-color);
                        root.value-edited(root.property-value);
                    }
                }
            }
            alpha-slider := Slider {
                minimum: 0.0;
                maximum: 1.0;
                value: 1.0;

                changed(value) => {
                    if (self.has-focus) {
                        root.property-value = ColorUtils.to-hex(wheel.selected-color);
                        root.value-edited(root.property-value);
                    }
                }
            }
        }
    }
}

export struct ConfigProperty {
    display-name: string,
    name: string,
    value: string,
    color-wheel: bool
}
export component ConfigInterface inherits Rectangle {
    in-out property <[ConfigProperty]> config-properties;
    callback config-changed(string, string);
    callback reset-theme();
    callback save-theme();
    callback reload();

    min-width: 0px;
    max-width: 10000px;
    background: Theme.background-panel;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-sublte;

    VerticalLayout {
        horizontal-stretch: 1;
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 5px;

            CustomButton {
                text: "Reset";

                border-radius: 6px;

                clicked => {
                    root.reset-theme();
                }
            }
            CustomButton {
                text: "Reload";

                border-radius: 6px;

                clicked => {
                    root.reload();
                }
            }
            CustomButton {
                text: "Save";

                border-radius: 6px;

                clicked => {
                    root.save-theme();
                }
            }
        }

        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            viewport-width: self.visible-width;

            property <int> cols: max(1, Math.floor((self.visible-width + 10px) / (175px + 10px)));

            HorizontalLayout {
                width: 100%;
                alignment: center;

                GridLayout {
                    spacing: 10px;

                    for prop[index] in config-properties : ConfigColorBlock {
                        row: Math.floor(index /cols);
                        col: Math.mod(index, cols);
                        horizontal-stretch: 1;

                        property-display-name: prop.display-name;
                        property-name: prop.name;
                        property-value: prop.value;
                        color-wheel: prop.color-wheel;

                        value-edited(new-value) => {
                            root.config-changed(prop.name, new-value);
                        }
                    }
                }
            }
        }
    }
}

export struct DiscoverSongStruct {
    name: string,
    id: string,
    art: image
}

export component DiscoverSong inherits Rectangle {
    in property <image> art;
    in property <string> name;
    in property <string> id;
    in property <color> text-color: Theme.text-primary;
    in property <length> font-size: 14px;

    callback download-song(int);

    height: 85px;
    min-width: 0px;
    border-radius: 4px;
    background: Theme.button-normal;

    touch := TouchArea {}

    HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Image {
            width: 65px;
            height: 65px;
            source: root.art;
            image-fit: contain;
            horizontal-stretch: 0;
            vertical-alignment: center;
        }

        Text {
            min-width: 0px;
            preferred-width: 0px;
            text: root.name;
            font-size: root.font-size;
            color: root.text-color;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

export component DiscoverInterface inherits Rectangle {
    min-width: 0px;
    max-width: 10000px;
    background: Theme.background-panel;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-sublte;

    in property <[DiscoverSongStruct]> found-songs;

    out property <string> current-text; // sent every text edit, actually only processed every 400ms
    in property <[string]> suggestions; // recieved when currentText is processed

    in-out property <length> discover-tab-height: sc-view.visible-height; // used for lazy loading

    in property <bool> is-searching;

    callback text-edited(string);
    callback text-submitted(string);

    callback download-song(int);

    changed current-text => {
        root.text-edited(current-text);
    }

    sc-view := ScrollView {
        width: 100%;
        height: 100%;

        property <int> cols: max(1, Math.floor((self.visible-width  - 16px + 10px) / (200px + 10px)));

        VerticalLayout {
            width: sc-view.visible-width;
            padding: 8px;
            spacing: 8px;

            Rectangle {
                width: 100%;
                height: 32px;
                border-radius: 6px;
                background: Theme.button-normal;

                TouchArea {
                    clicked => { search-input.focus(); }
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    Text {
                        text: "\u{f0387}";
                        vertical-alignment: center;
                        color: Theme.text-primary;
                        horizontal-stretch: 0;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        clip: true;
                        background: transparent;

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                            color: Theme.text-primary;
                            text <=> root.current-text;
                            single-line: true;

                            accepted => {
                                 self.clear-focus();
                                 root.text-submitted(root.current-text);
                            }
                        }
                    }
                }
            }

            if (found-songs.length > 0) : GridLayout {
                width: 100%;
                spacing: 10px;

                for song[index] in found-songs : DiscoverSong {
                    row: Math.floor(index / sc-view.cols);
                    col: Math.mod(index, sc-view.cols);
                    horizontal-stretch: 1;

                    name: song.name;
                    id: song.id;
                    art: song.art;
                }
            }
            if (found-songs.length == 0 && !is-searching) : Text {
                horizontal-alignment: center;
                color: Theme.text-primary;
                text: "No results...";
            }
            if (is-searching) : Text {
                text: ("\u{f002} Searching" + (mod(floor(animation-tick() / 400ms), 4) == 0 ? "" : (mod(floor(animation-tick() / 400ms), 4) == 1 ? "." : (mod(floor(animation-tick() / 400ms), 4) == 2 ? ".." : "..."))));
                color: Theme.text-primary.brighter(0.5 + 0.5 * sin(animation-tick() / 600ms * 1rad));

                horizontal-alignment: center;
            }
        }
    }
}

export component ContentArea inherits Rectangle {
    min-width: 0px;
    max-width: 100000px;

    in-out property <[ConfigProperty]> config-properties;

    in property <int> current-tab: 0; // 0 = config, 1 = discover, 2 = playlist

    in property <string> current-sound: "Loading..."; // CurrentImage {
    in property <image> current-image; // Current song image
    in property <string> toggle-button: "Loading..";

    in property <bool> is-playing: false;

    in property <string> current-time-text: "0:00";
    in property <string> total-time-text: "0:00";
    in-out property <float> volume: 1.0;

    in property <[string]> playlists;
    in property <[PendingSong]> pendingSongs: [];

    // search discover tab
    out property <string> current-text;
    in property <[string]> suggestions;
    out property <string> final-text;
    out property <length> discover-tab-height;

    in property <[DiscoverSongStruct]> found-songs;
    in property <bool> is-searching;

    callback text-edited(string);
    callback text-submitted(string);
    callback download-song(int);
    // ----------------------------------

    callback playlist_set(int);
    callback song_set(int);
    callback next-song();
    callback previous-song();
    callback toggle-music();
    callback volume-changed(float);

    callback config-changed(string, string);
    callback reset-theme();
    callback save-theme();
    callback reload();

    if root.current-tab == 0 : ConfigInterface {
        width: 100%; height: 100%;

        config-properties: config-properties;

        config-changed(name, value) => {
            config-changed(name, value); // check what changed on ui and set the change if valid
        }
        reset-theme => {
            root.reset-theme();
        }
        save-theme => {
            root.save-theme();
        }
        reload => {
            root.reload();
        }
    }
    if root.current-tab == 1 : DiscoverInterface {
        width: 100%;
        height: 100%;

        suggestions: suggestions;
        discover-tab-height: discover-tab-height;

        found-songs: found-songs;
        is-searching: is-searching;

        text-edited(new-text) => {
            root.text-edited(new-text);
        }
        text-submitted(new-text) => {
            root.text-submitted(new-text);
        }
        download-song(id) => {
            root.download-song(id);
        }
    }
    if root.current-tab == 2  : SoundsInterface {
        width: 100%; height: 100%;

        current-image: current-image;
        current-sound: current-sound;
        pendingSongs: pendingSongs;
        toggle-button: toggle-button;

        previous-song => {
            root.previous-song();
        }
        next-song => {
            root.next-song();
        }
        toggle-music => {
            root.toggle-music();
        }
        song-set(index) =>  {
            root.song_set(index);
        }

        current-time-text: current-time-text;
        total-time-text: total-time-text;
        volume <=> root.volume;

        volume-changed(val) => {
            root.volume-changed(val)
        }
    }
}