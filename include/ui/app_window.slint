import "../../assets/fonts/baseFont.ttf";
import { SoundsInterface, LeftInterface, PendingSong, Theme } from "buttonThemes.slint";

export component OpenPlayerUI inherits Window {
    default-font-family: "0xProto Nerd Font";

    in-out property <string> current-sound: "Loading..."; // CurrentImage {
    in-out property <image> current-image; // Current song image
    in-out property <string> toggle-button: "Loading..";

    in property <bool> is-playing: false;

    in property <string> current-time-text: "0:00";
    in property <string> total-time-text: "0:00";
    in-out property <float> volume: 1.0;

    in-out property <[string]> playlists;
    in-out property <[PendingSong]> pendingSongs: [];

    // set sizes
    min-width: 750px;
    min-height: 550px;

    preferred-width: 1100px;
    preferred-height: 750px;

    background: Theme.background-main;

    title: "OpenPlayer";

    callback playlist_set(int);
    callback song_set(int);

    callback next-song();
    callback previous-song();
    callback toggle-music();

    callback volume-changed(float);

    HorizontalLayout {
        spacing: 10px;
        padding: 10px;

        // Left Interface
        LeftInterface {
            playlists: playlists;
            
            playlist_set(index) => {
                root.playlist_set(index)
            }

            is-playing: is-playing;
        }

        // Sounds Interface
        SoundsInterface {
            horizontal-stretch: 1;
            current-image: current-image;
            current-sound: current-sound;
            pendingSongs: pendingSongs;
            toggle-button: toggle-button;

            previous-song => {
                root.previous-song();
            }
            next-song => {
                root.next-song();
            }
            toggle-music => {
                root.toggle-music();
            }
            song-set(index) =>  {
                root.song_set(index);
            }

            current-time-text: current-time-text;
            total-time-text: total-time-text;
            volume <=> root.volume;

            volume-changed(val) => {
                root.volume-changed(val)
            }
        }
    }
}