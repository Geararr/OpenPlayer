import { Button, VerticalBox, HorizontalBox, TabWidget, ScrollView } from "std-widgets.slint";
import "../../assets/fonts/baseFont.ttf";

export struct PendingSong {
    image: image,
    title: string,
}

export struct Playlist {
    title: string
}

export component OpenPlayerUI inherits Window {
    in-out property <string> current-sound: "Loading..."; // Current song
    in-out property <image> current-image; // Current song image
    in-out property <string> toggle-button: "Loading..";

    in-out property <[Playlist]> playlists;
    in-out property <[PendingSong]> pendingSongs: [];

    width: 700px;
    height: 700px;
    background: rgba(17, 17, 27, 0.75);

    title: "OpenPlayer";

    callback playlist_set(int);
    callback song_set(int);

    callback next-song();
    callback previous-song();

    callback toggle-music();

    VerticalBox {
        alignment: start;
        cross-axis-alignment: center;
        spacing: 10px;

        Image {
            width: 200px; height: 200px;
            source: current-image;
            image-fit: contain;
            vertical-alignment: top;
        }

        Text {
            text: current-sound;
            color: rgb(215, 215, 247);
            font-size: 24px;
        }

        HorizontalBox {
            alignment: center;
            cross-axis-alignment: center;
            spacing: 10px;

            Button {
                text: "\u{000F04AE}";
                clicked() => {
                    previous-song();
                }
            }

            Button {
                text: toggle-button;
                clicked() => {
                    toggle-music();
                }
            }

            Button {
                text: "\u{000F04AD}";
                clicked() => {
                    next-song();
                }
            }
        }

        Rectangle {
            background: rgba(17, 17, 27, 0.80);
            width: 98%;
            height: 50px;
            border-radius: 4px;

            ScrollView {
                width: 100%;
                height: 100%;

                HorizontalBox {
                    for playlist[index] in playlists : Button {
                        text: playlist.title;

                        clicked => {
                            root.playlist_set(index);
                        }
                    }
                }
            }
        }

        Rectangle {
            background: rgba(17, 17, 27, 0.80);
            width: 98%;
            height: 58%;
            border-radius: 4px;

            VerticalLayout {
                alignment: start;
                cross-axis-alignment: center;
                spacing: 15px;

                for pending_song[index] in pendingSongs : Rectangle {
                    height: 50px;
                    background: ta.has-hover ? rgba(255, 255, 255, 0.1) : transparent;
                    border-radius: 8px;

                    ta := TouchArea {
                        clicked => {
                            root.song_set(index);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 15px;
                        alignment: center;

                        cross-axis-alignment: center;

                        Image {
                            width: 20px; height: 20px;
                            source: pending-song.image;
                        }
                        Text {
                            text: pending-song.title;
                            font-size: 20px;
                            color: rgb(215, 215, 247);
                        }
                    }
                }
            }
        }
    }
}