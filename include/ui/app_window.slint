import "../../assets/fonts/baseFont.ttf";
import { SoundsInterface, LeftInterface, ContentArea, PendingSong, Theme, Default-Theme, ConfigProperty, ColorUtils } from "buttonThemes.slint";
export { Theme, ColorUtils, Default-Theme }

export component OpenPlayerUI inherits Window {
    default-font-family: "0xProto Nerd Font";

    in-out property <int> current-tab: 1; // 0 = default, 1 = playlists, 2 = config

    in-out property <string> current-sound: "Loading..."; // CurrentImage {
    in-out property <image> current-image; // Current song image
    in-out property <string> toggle-button: "Loading..";

    in property <bool> is-playing: false;

    in property <string> current-time-text: "0:00";
    in property <string> total-time-text: "0:00";
    in-out property <float> volume: 1.0;

    in-out property <[string]> playlists;
    in-out property <[PendingSong]> pendingSongs;

    in-out property <[ConfigProperty]> config-properties;

    in property <bool> valid-music-dir: false;

    // set sizes
    min-width: 750px;
    min-height: 550px;

    preferred-width: 1100px;
    preferred-height: 750px;

    background: Theme.background-main;

    title: "OpenPlayer";
    icon: @image-url("../../assets/openplayer_icon.svg");

    callback playlist_set(int);
    callback song_set(int);
    callback next-song();
    callback previous-song();
    callback toggle-music();
    callback volume-changed(float);
    callback config-changed(string, string);
    callback reset-theme();
    callback save-theme();
    callback reload();

    HorizontalLayout {
        spacing: 10px;
        padding: 10px;

        // Left Interface
        LeftInterface {
            playlists: playlists;
            is-playing: is-playing;

            playlist_set(index) => {
                root.playlist_set(index)
            }

            set-tab(index) => {
                root.current-tab = index;
            }
        }

        ContentArea {
            horizontal-stretch: 1;
            current-tab: current-tab;
            current-image: current-image;
            current-sound: current-sound;
            pendingSongs: pendingSongs;
            toggle-button: toggle-button;
            current-time-text: current-time-text;
            total-time-text: total-time-text;
            volume <=> root.volume;

            config-properties: config-properties;

            config-changed(name, value) => {
                config-changed(name, value);
            }
            reset-theme => {
                root.reset-theme();
            }
            save-theme => {
                root.save-theme();
            }
            reload => {
                root.reload();
            }

            previous-song => { root.previous-song(); }
            next-song => { root.next-song(); }
            toggle-music => { root.toggle-music(); }
            song_set(index) => { root.song_set(index); }
            volume-changed(val) => { root.volume-changed(val); }
        }
    }
}